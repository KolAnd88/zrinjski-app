{
  "name": "zrinjski-app",
  "version": "0.1.0",
  "private": true,
  "description": "VHMRK Zrinjski Cup — mobilna + web aplikacija za rukometni turnir veterana",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc -b packages/core packages/ui-tokens",
    "db:types": "supabase gen types typescript --local > packages/core/src/types/database.ts",
    "test": "npm run test -w @zrinjski/core"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  }
}
