{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web-admin",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--workspace", "@zrinjski/web-admin"],
      "port": 5173
    },
    {
      "name": "web-admin-demo",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--workspace", "@zrinjski/web-admin", "--", "--port", "5174"],
      "port": 5174,
      "env": { "VITE_SUPABASE_URL": "", "VITE_SUPABASE_ANON_KEY": "" }
    },
    {
      "name": "mobile-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["expo", "start", "--web", "--port", "8081"],
      "cwd": "apps/mobile",
      "port": 8081
    }
  ]
}
